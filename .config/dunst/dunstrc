[global]
    # Posição
    origin = top-right
    offset = (10, 40)

    # Tamanho
    width = 320
    height = 100
    padding = 10
    horizontal_padding = 12

    # Borda roxa e quadrada
    frame_width = 2
    frame_color = "#800080"
    corner_radius = 0

    # Fonte (mesma da sua polybar)
    font = JetBrains Mono Nerd Font 10

    # Texto
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center

    # Separador
    separator_height = 1
    separator_color = frame

    # Timeout padrão (segundos)
    idle_threshold = 120

    # Mouse
    mouse_left_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#282A2E"
    foreground = "#C5C8C6"
    frame_color = "#B294BB"
    timeout = 4

[urgency_normal]
    background = "#282A2E"
    foreground = "#C5C8C6"
    frame_color = "#B294BB"
    timeout = 6

[urgency_critical]
    background = "#282A2E"
    foreground = "#C5C8C6"
    frame_color = "#FF0000"
    timeout = 0

